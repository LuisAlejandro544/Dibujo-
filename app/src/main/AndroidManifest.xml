<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exportar a la galería: en Android 10+ se usa MediaStore, que no pide
         permisos. En equipos API 26–28 (minSdk) hace falta este permiso, que
         la app solicita en tiempo de ejecución solo en esas versiones. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Vibración háptica al dibujar/deshacer (configurable en Opciones). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/TemaDibujo">

        <!-- La ventana de depuración (source set debug) es un icono de launcher
             aparte. Para que cada icono abra SIEMPRE su propia pantalla (y no
             que el launcher reanude la última Activity de la tarea, que era el
             bug de "abro Dibujo y me sale Debug"), cada Activity vive en su
             propia tarea: afinidad distinta + singleTask. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.dibujo.android"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Compartir el dibujo: expone un PNG temporal de la caché por un
             content:// URI, sin pedir permiso de almacenamiento. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
